@model IEnumerable<personal_finance_Tracker.Models.Transaction>

@{
    ViewData["Title"] = "Expenses";

    var categories =
        ViewBag.Categories
        as List<personal_finance_Tracker.Models.Category>
        ?? new List<personal_finance_Tracker.Models.Category>();

    var hasFilters =
        !string.IsNullOrWhiteSpace(ViewBag.Search as string)
        || ViewBag.CategoryId != null
        || !string.IsNullOrWhiteSpace(ViewBag.FromDate as string)
        || !string.IsNullOrWhiteSpace(ViewBag.ToDate as string);
}

<div class="container-fluid">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div class="d-flex align-items-center gap-3">

            <div class="bg-danger-subtle text-danger rounded-3 p-3">
                <i class="bi bi-arrow-down-circle fs-3"></i>
            </div>

            <div>
                <h2 class="fw-bold mb-1">
                    Expenses
                </h2>

                <p class="text-muted mb-0">
                    Manage and track your expense transactions.
                </p>
            </div>

        </div>

        <div class="d-flex gap-2">

            <a asp-action="CreateCategory"
               class="btn btn-outline-danger">

                <i class="bi bi-tags me-1"></i>
                Manage Categories

            </a>

            <a asp-action="Create"
               class="btn btn-danger">

                <i class="bi bi-plus-lg me-1"></i>
                Add Expense

            </a>

        </div>

    </div>


    <!-- Summary -->
    <div class="row mb-4">

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Total Expenses
                            </p>

                            <h3 class="fw-bold text-danger mb-0">
                                ₹@Convert.ToDecimal(
                                    ViewBag.TotalExpense
                                ).ToString("N2")
                            </h3>

                        </div>

                        <div class="bg-danger-subtle text-danger rounded-3 p-3">

                            <i class="bi bi-arrow-down-circle fs-3"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <div>

                    <h5 class="fw-bold mb-1">
                        <i class="bi bi-funnel me-2 text-danger"></i>
                        Filter Expenses
                    </h5>

                    <p class="text-muted small mb-0">
                        Search and filter your expense records.
                    </p>

                </div>

                @if (hasFilters)
                {
                    <span class="badge bg-danger-subtle text-danger">
                        <i class="bi bi-funnel-fill me-1"></i>
                        Filters Applied
                    </span>
                }

            </div>


            <form asp-action="Index" method="get">

                <div class="row g-3">

                    <!-- Search -->
                    <div class="col-md-4">

                        <label class="form-label fw-semibold">
                            Search
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-light border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>

                            <input type="text"
                                   name="search"
                                   value="@ViewBag.Search"
                                   class="form-control border-start-0"
                                   placeholder="Search description..." />

                        </div>

                    </div>


                    <!-- Category -->
                    <div class="col-md-3">

                        <label class="form-label fw-semibold">
                            Category
                        </label>

                        <select name="categoryId"
                                class="form-select">

                            <option value="">
                                All Categories
                            </option>

                            @foreach (var category in categories)
                            {
                                if (ViewBag.CategoryId == category.Id)
                                {
                                    <option value="@category.Id" selected>
                                        @category.Name
                                    </option>
                                }
                                else
                                {
                                    <option value="@category.Id">
                                        @category.Name
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- From Date -->
                    <div class="col-md-2">

                        <label class="form-label fw-semibold">
                            From Date
                        </label>

                        <input type="date"
                               name="fromDate"
                               value="@ViewBag.FromDate"
                               class="form-control" />

                    </div>


                    <!-- To Date -->
                    <div class="col-md-2">

                        <label class="form-label fw-semibold">
                            To Date
                        </label>

                        <input type="date"
                               name="toDate"
                               value="@ViewBag.ToDate"
                               class="form-control" />

                    </div>


                    <!-- Search -->
                    <div class="col-md-1 d-flex align-items-end">

                        <button type="submit"
                                class="btn btn-danger w-100"
                                title="Apply Filters">

                            <i class="bi bi-search"></i>

                        </button>

                    </div>

                </div>


                @if (hasFilters)
                {
                    <div class="mt-3">

                        <a asp-action="Index"
                           class="btn btn-sm btn-outline-secondary">

                            <i class="bi bi-x-circle me-1"></i>
                            Clear Filters

                        </a>

                    </div>
                }

            </form>

        </div>

    </div>


    <!-- Expense List -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            <div class="p-4 border-bottom">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <h5 class="fw-bold mb-1">

                            <i class="bi bi-receipt text-danger me-2"></i>

                            Expense List

                        </h5>

                        <p class="text-muted small mb-0">

                            @Model.Count() expense record@(Model.Count() == 1 ? "" : "s") found.

                        </p>

                    </div>

                    @if (Model.Any())
                    {
                        <span class="badge bg-danger-subtle text-danger">

                            @Model.Count() Records

                        </span>
                    }

                </div>

            </div>


            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="px-4">
                                    Date
                                </th>

                                <th>
                                    Category
                                </th>

                                <th>
                                    Description
                                </th>

                                <th>
                                    Amount
                                </th>

                                <th class="text-end px-4">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="px-4">

                                        <div class="fw-semibold">

                                            @item.TransactionDate.ToString("dd MMM yyyy")

                                        </div>

                                    </td>


                                    <td>

                                        <span class="badge bg-danger-subtle text-danger">

                                            <i class="bi bi-tag me-1"></i>

                                            @item.Category?.Name

                                        </span>

                                    </td>


                                    <td>

                                        @if (string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                        else
                                        {
                                            @item.Description
                                        }

                                    </td>


                                    <td>

                                        <span class="fw-semibold text-danger">

                                            - ₹@item.Amount.ToString("N2")

                                        </span>

                                    </td>


                                    <td class="text-end px-4">

                                        <!-- Edit -->
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary me-1"
                                           title="Edit">

                                            <i class="bi bi-pencil"></i>

                                        </a>


                                        <!-- Delete -->
                                        <form asp-action="Delete"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this expense?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Delete">

                                                <i class="bi bi-trash"></i>

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5 px-3">

                    <div class="bg-danger-subtle text-danger rounded-circle d-inline-flex p-3 mb-3">

                        <i class="bi bi-receipt fs-2"></i>

                    </div>

                    <h5 class="fw-bold">
                        No expense records found
                    </h5>

                    <p class="text-muted mb-4">

                        @if (hasFilters)
                        {
                            <span>
                                Try changing your filters or clear them to see all expenses.
                            </span>
                        }
                        else
                        {
                            <span>
                                Start tracking your expenses by adding your first expense.
                            </span>
                        }

                    </p>

                    @if (hasFilters)
                    {
                        <a asp-action="Index"
                           class="btn btn-outline-secondary me-2">

                            <i class="bi bi-x-circle me-1"></i>
                            Clear Filters

                        </a>
                    }

                    <a asp-action="Create"
                       class="btn btn-danger">

                        <i class="bi bi-plus-lg me-1"></i>
                        Add Expense

                    </a>

                </div>
            }

        </div>

    </div>

</div>