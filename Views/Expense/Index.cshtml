@model IEnumerable<personal_finance_Tracker.Models.Transaction>

@{
    ViewData["Title"] = "Expenses";

    var categories =
        ViewBag.Categories
        as List<personal_finance_Tracker.Models.Category>
        ?? new List<personal_finance_Tracker.Models.Category>();

    var hasFilters =
        !string.IsNullOrWhiteSpace(ViewBag.Search as string)
        || ViewBag.CategoryId != null
        || !string.IsNullOrWhiteSpace(ViewBag.FromDate as string)
        || !string.IsNullOrWhiteSpace(ViewBag.ToDate as string);
}

<div class="container-fluid">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <div class="bg-danger-subtle text-danger rounded-3 p-2">
                    <i class="bi bi-arrow-down-circle fs-5"></i>
                </div>

                <h2 class="fw-bold mb-0">
                    Expenses
                </h2>
            </div>
            <p class="text-muted mb-0">
                View, search, and manage your expense records.
            </p>
        </div>

        @* <div class="d-flex gap-2">

            <a asp-action="CreateCategory" class="btn btn-outline-danger">

                <i class="bi bi-tags me-1"></i>
                Manage Categories

            </a>

            <a asp-action="Create" class="btn btn-danger">

                <i class="bi bi-plus-lg me-1"></i>
                Add Expense

            </a>

        </div> *@
        <div class="d-flex flex-wrap align-items-center gap-2">

            <span class="badge bg-danger-subtle text-danger px-3 py-2">
                <i class="bi bi-receipt me-1"></i>
                @Model.Count()
                record@(Model.Count() == 1 ? "" : "s")
            </span>

            <a asp-action="CreateCategory" class="btn btn-outline-danger">

                <i class="bi bi-tags me-1"></i>
                Manage Categories

            </a>

            <a asp-action="Create" class="btn btn-danger">

                <i class="bi bi-plus-lg me-1"></i>
                Add Expense

            </a>

        </div>

    </div>


    <!-- Summary -->
    <div class="row mb-4">
        <div class="col-xl-4 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">
                                Total Expenses
                            </p>
                            <h3 class="fw-bold text-danger mb-0">
                                ₹@Convert.ToDecimal(ViewBag.TotalExpense).ToString("N2")
                            </h3>

                        </div>

                        <div class="bg-danger-subtle text-danger rounded-circle d-flex align-items-center justify-content-center"
                             style="width: 52px; height: 52px;">

                            <i class="bi bi-arrow-down-circle fs-3"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex flex-column flex-md-row justify-content-betweeen align-items-md-center gap-2 mb-3">

                <div>

                    <h5 class="fw-semibold mb-1">
                        <i class="bi bi-funnel me-1 text-danger"></i>
                        Filter Expenses
                    </h5>

                    <p class="text-muted small mb-0">
                        Search and filter your expense records.
                    </p>

                </div>

                @if (hasFilters)
                {
                    <span class="badge bg-danger-subtle text-danger px-3 py-2">
                        <i class="bi bi-check-circle me-1"></i>
                        Filters Applied
                    </span>
                }

            </div>


            <form asp-action="Index" method="get">

                <div class="row g-3">

                    <!-- Search -->
                    <div class="col-xl-3 col-md-6">

                        <label class="form-label fw-semibold">
                            Search
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-light border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>

                            <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0"
                                   placeholder="Search description..." />

                        </div>

                    </div>


                    <!-- Category -->
                    <div class="col-xl-3 col-md-6">

                        <label class="form-label fw-semibold">
                            Category
                        </label>

                        <select name="categoryId" class="form-select">

                            <option value="">
                                All Categories
                            </option>

                            @foreach (var category in categories)
                            {
                                if (ViewBag.CategoryId == category.Id)
                                {
                                    <option value="@category.Id" selected>
                                        @category.Name
                                    </option>
                                }
                                else
                                {
                                    <option value="@category.Id">
                                        @category.Name
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- From Date -->
                    <div class="col-xl-2 col-md-6">

                        <label class="form-label fw-semibold">
                            From Date
                        </label>

                        <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" />

                    </div>


                    <!-- To Date -->
                    <div class="col-xl-2 col-md-6">

                        <label class="form-label fw-semibold">
                            To Date
                        </label>

                        <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" />

                    </div>


                    <!-- Search -->
                    <div class="col-xl-2 col-12
                        d-flex
                        align-items-end
                        gap-2">

                        <button type="submit" class="btn btn-danger flex-grow-1">

                            <i class="bi bi-search me-1"></i>
                            Filter

                        </button>

                        @if (hasFilters)
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary" title="Clear Filters">

                                <i class="bi bi-x-lg"></i>

                            </a>

                            
                        }
                    </div>

                </div>



            </form>

        </div>

    </div>


    <!-- Expense List -->
    <div class="card border-0 shadow-sm">


        <div class="card-header bg-white border-0
            d-flex flex-column flex-md-row
            justify-content-between
            align-items-md-center
            gap-2
            pt-4 px-4">

            <div>

                <h5 class="fw-bold mb-1">

                    <i class="bi bi-receipt text-danger me-2"></i>

                    Expense List

                </h5>

                <p class="text-muted small mb-0">
                    Showing @Model.Count() expense
                    record@(Model.Count() == 1 ? "" : "s")
                </p>

            </div>

                   
            <span class="badge bg-danger-subtle text-danger px-3 py-2">

                <i class="bi bi-cash-stack me-1"></i>
                Expense

            </span>
        </div>

        <div class="card-body px-4">

            


            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>

                        <tr>

                            <th>
                                Date
                            </th>

                            <th>
                                Category
                            </th>

                            <th>
                                Description
                            </th>

                            <th class="text-end">
                                Amount
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>

                                        <div class="fw-semibold">

                                            @item.TransactionDate.ToString("dd MMM yyyy")

                                        </div>

                                    </td>


                                    <td>

                                        <span class="badge bg-danger-subtle text-danger px-2 py-2">

                                            <i class="bi bi-tag me-1"></i>

                                            @(item.Category?.Name ?? "Uncategorized")

                                        </span>

                                    </td>


                                    <td>

                                        @if (string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                @item.Description
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <span class="fw-bold text-danger">

                                            - ₹@item.Amount.ToString("N2")

                                        </span>

                                    </td>


                                    <td class="text-end">

                                        <div class="d-inline-flex gap-1">
                                            <!-- Edit -->
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary me-1" title="Edit">

                                                <i class="bi bi-pencil"></i>

                                            </a>


                                            <!-- Delete -->
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this expense?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">

                                                    <i class="bi bi-trash"></i>

                                                </button>

                                            </form>
                                        </div>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {

                            <tr>
                                <td colspan="5">
                                    <div class="text-center py-5">
                                        <div class="bg-danger-subtle text-danger rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                                             style="width: 70px; height: 70px;">
                                            <i class="bi bi-receipt fs-2"></i>
                                        </div>
                                        <h5 class="fw-semibold">
                                            No expence records found
                                        </h5>
                                        <p class="text-muted mb-3">
                                            @if (hasFilters)
                                            {
                                                <span>
                                                    Try changing your filters
                                                    or clear them to see all
                                                    expense records.
                                                </span>
                                            }
                                            else
                                            {
                                                <span>
                                                    Start by adding your first
                                                    expense transaction.
                                                </span>
                                            }
                                        </p>
                                        <div class="d-flex justify-content-center gap-2">
                                            @if (hasFilters)
                                            {
                                                <a asp-action="Index" class="btn btn-outline-secondary">
                                                    <i class="bi bi-x-lg me-1"></i>
                                                    Clear Filters
                                                </a>
                                            }
                                            <a asp-action="Create" class="btn btn-danger">
                                                <i class="bi bi-plus-lg me-1"></i>
                                                Add Income
                                            </a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
            
        </div>

    </div>

</div>