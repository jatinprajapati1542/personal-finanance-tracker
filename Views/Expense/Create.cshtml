@model personal_finance_Tracker.Models.Transaction

@{
ViewData["Title"] = "Add Expense";

var categories =
    ViewBag.CategoryId
    as Microsoft.AspNetCore.Mvc.Rendering.SelectList
    ?? new Microsoft.AspNetCore.Mvc.Rendering.SelectList(
        new List<personal_finance_Tracker.Models.Category>());

}

<div class="container-fluid">

<!-- Header -->
<div class="d-flex flex-column flex-md-row
    justify-content-between
    align-items-md-center
    gap-3
    mb-4">

    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <div class="bg-danger-subtle text-danger rounded-3 p-2">
                <i class="bi bi-arrow-up-circle fs-5"></i>
            </div>

            <h2 class="fw-bold mb-0">
                Add Expense
            </h2>
        </div>

        <p class="text-muted mb-0">
            Add a new expense transaction to your account.
        </p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>
        Back to Expenses
    </a>
</div>


<!-- Form Card -->
<div class="row justify-content-center">

    <div class="col-xl-9 col-lg-10">

        <div class="card border-0 shadow-sm">

            <!-- Card Header -->
            <div class="card-header bg-danger-subtle border-0 p-4">

                <div class="d-flex align-items-center gap-3">

                    <div class="bg-danger text-white rounded-3
                        d-flex align-items-center
                        justify-content-center"
                        style="width: 48px; height: 48px;">

                        <i class="bi bi-plus-lg fs-4"></i>

                    </div>

                    <div>
                        <h5 class="fw-bold mb-1">
                            Expense Details
                        </h5>

                        <p class="text-muted small mb-0">
                            Enter the details of your expense.
                        </p>
                    </div>

                </div>

            </div>


            <!-- Card Body -->
            <div class="card-body p-4">

                <form asp-action="Create" method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>


                    <div class="row g-4">

                        <!-- Amount -->
                        <div class="col-md-6">

                            <label asp-for="Amount"
                                   class="form-label fw-semibold">
                                Amount
                            </label>

                            <div class="input-group">

                                <span class="input-group-text
                                    bg-danger-subtle
                                    text-danger
                                    border-danger-subtle">
                                    ₹
                                </span>

                                <input asp-for="Amount"
                                       class="form-control"
                                       placeholder="Enter amount" />

                            </div>

                            <span asp-validation-for="Amount"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Category -->
                        <div class="col-md-6">

                            <label asp-for="CategoryId"
                                   class="form-label fw-semibold">
                                Category
                            </label>

                            <select asp-for="CategoryId"
                                    class="form-select"
                                    asp-items="ViewBag.CategoryId">

                                <option value="">
                                    Select Category
                                </option>

                            </select>

                            <span asp-validation-for="CategoryId"
                                  class="text-danger small">
                            </span>


                        </div>


                        <!-- Date -->
                        <div class="col-md-6">

                            <label asp-for="TransactionDate"
                                   class="form-label fw-semibold">
                                Date
                            </label>

                            <input asp-for="TransactionDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="TransactionDate"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Description -->
                        <div class="col-12">

                            <label asp-for="Description"
                                   class="form-label fw-semibold">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Add an optional description..."></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Buttons -->
                        <div class="col-12">

                            <hr class="my-1">

                            <div class="d-flex flex-wrap gap-2 mt-3">

                                <button type="submit"
                                        class="btn btn-danger">

                                    <i class="bi bi-check-lg me-1"></i>
                                    Save Expense

                                </button>

                                <a asp-action="Index"
                                   class="btn btn-outline-secondary">
                                    Cancel
                                </a>

                            </div>

                        </div>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


</div>

@section Scripts {

<partial name="_ValidationScriptsPartial" />
}
