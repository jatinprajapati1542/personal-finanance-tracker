@model personal_finance_Tracker.ViewModels.TransactionViewModel

@{
    ViewData["Title"] = "Transactions";
}

<div class="container-fluid">

    <!-- Header -->

    <div class="d-flex flex-column flex-md-row
        justify-content-between
        align-items-md-center
        gap-3
        mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Transactions
            </h2>

            <p class="text-muted mb-0">
                View and manage your income and expense transactions.
            </p>
        </div>


        <div class="d-flex flex-wrap gap-2">

            <a asp-action="ExportExcel" asp-route-type="@Model.Type" asp-route-categoryId="@Model.CategoryId"
               asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
               asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")" asp-route-search="@Model.Search"
               class="btn btn-success">

                <i class="bi bi-file-earmark-excel me-1"></i>

                Excel

            </a>


            <a asp-action="ExportPdf" asp-route-type="@Model.Type" asp-route-categoryId="@Model.CategoryId"
               asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
               asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")" asp-route-search="@Model.Search"
               class="btn btn-danger">

                <i class="bi bi-file-earmark-pdf me-1"></i>

                PDF

            </a>

        </div>

    </div>

    <!-- Summary Cards -->

    <div class="row g-4 mb-4">

        <!-- Total Income -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <p class="text-muted mb-2">
                                Total Income
                            </p>

                            <h3 class="fw-bold text-success mb-0">

                                ₹@Model.TotalIncome.ToString("N2")

                            </h3>

                        </div>

                        <div class="rounded-circle bg-success-subtle
                            text-success d-flex
                            align-items-center
                            justify-content-center" style="width: 48px; height: 48px;">

                            <i class="bi bi-arrow-down-circle fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Total Expense -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <p class="text-muted mb-2">
                                Total Expense
                            </p>

                            <h3 class="fw-bold text-danger mb-0">

                                ₹@Model.TotalExpense.ToString("N2")

                            </h3>

                        </div>

                        <div class="rounded-circle bg-danger-subtle
                            text-danger d-flex
                            align-items-center
                            justify-content-center" style="width: 48px; height: 48px;">

                            <i class="bi bi-arrow-up-circle fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Balance -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <p class="text-muted mb-2">
                                Balance
                            </p>

                            <h3 class="fw-bold mb-0
                                @(Model.Balance >= 0
                                    ? "text-primary"
                                    : "text-danger")">

                                ₹@Model.Balance.ToString("N2")

                            </h3>

                        </div>

                        <div class="rounded-circle bg-primary-subtle
                            text-primary d-flex
                            align-items-center
                            justify-content-center" style="width: 48px; height: 48px;">

                            <i class="bi bi-wallet2 fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Total Transactions -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <p class="text-muted mb-2">
                                Total Transactions
                            </p>

                            <h3 class="fw-bold mb-0">

                                @Model.TotalTransactions

                            </h3>

                        </div>

                        <div class="rounded-circle bg-secondary-subtle
                            text-secondary d-flex
                            align-items-center
                            justify-content-center" style="width: 48px; height: 48px;">

                            <i class="bi bi-receipt fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
    <!-- Filters -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between
                align-items-center mb-3">

                <div>
                    <h5 class="fw-semibold mb-1">
                        Filter Transactions
                    </h5>
                    <small class="text-muted">
                        Search and filter your transactions.
                    </small>
                </div>
            </div>


            <form asp-action="Index" method="get">

                <div class="row g-3">

                    <!-- Search -->

                    <div class="col-12 col-lg-4">

                        <label class="form-label fw-semibold">
                            Search
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text" name="search" value="@Model.Search" class="form-control"
                                   placeholder="Search description or category..." />

                        </div>

                    </div>


                    <!-- Type -->

                    <div class="col-12 col-sm-6 col-lg-2">

                        <label class="form-label fw-semibold">
                            Type
                        </label>

                        <select name="type" class="form-select">

                            <option value="">
                                All Types
                            </option>

                            @if (Model.Type ==
                                personal_finance_Tracker.Models.TransactionType.Income)
                            {
                                <option value="Income" selected>
                                    Income
                                </option>
                            }
                            else
                            {
                                <option value="Income">
                                    Income
                                </option>
                            }

                            @if (Model.Type ==
                                personal_finance_Tracker.Models.TransactionType.Expense)
                            {
                                <option value="Expense" selected>
                                    Expense
                                </option>
                            }
                            else
                            {
                                <option value="Expense">
                                    Expense
                                </option>
                            }

                        </select>

                    </div>


                    <!-- Category -->

                    <div class="col-12 col-sm-6 col-lg-2">

                        <label class="form-label fw-semibold">
                            Category
                        </label>

                        <select name="categoryId" class="form-select">

                            <option value="">
                                All Categories
                            </option>

                            @foreach (var category in Model.Categories)
                            {
                                if (Model.CategoryId == category.Id)
                                {
                                    <option value="@category.Id" selected>
                                        @category.Name
                                    </option>
                                }
                                else
                                {
                                    <option value="@category.Id">
                                        @category.Name
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- Start Date -->

                    <div class="col-12 col-sm-6 col-lg-2">

                        <label class="form-label fw-semibold">
                            From
                        </label>

                        <input type="date" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                               class="form-control" />

                    </div>


                    <!-- End Date -->

                    <div class="col-12 col-sm-6 col-lg-2">

                        <label class="form-label fw-semibold">
                            To
                        </label>

                        <input type="date" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                               class="form-control" />

                    </div>


                    <!-- Buttons -->

                    <div class="col-12">
                        <div class="d-flex flex-wrap gap-2">

                            <button type="submit" class="btn btn-primary">

                                <i class="bi bi-funnel me-1"></i>

                                Apply Filters

                            </button>


                            <a asp-action="Index" class="btn btn-outline-secondary">

                                <i class="bi bi-arrow-counterclockwise me-1"></i>

                                Reset

                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- Transactions -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">
                        Transaction List
                    </h5>

                    <small class="text-muted">

                        @Model.TotalTransactions
                        transaction@(Model.TotalTransactions == 1 ? "" : "s")

                    </small>

                </div>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.Transactions.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    Date
                                </th>

                                <th>
                                    Type
                                </th>

                                <th>
                                    Category
                                </th>

                                <th>
                                    Description
                                </th>

                                <th class="text-end">
                                    Amount
                                </th>

                                <th class="text-end pe-4">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var transaction in Model.Transactions)
                            {
                                <tr>

                                    <!-- Date -->

                                    <td class="ps-4 text-nowrap">

                                        @transaction.TransactionDate.ToString("dd MMM yyyy")

                                    </td>


                                    <!-- Type -->

                                    <td>

                                        @if (transaction.Type ==
                                            personal_finance_Tracker.Models.TransactionType.Income)
                                        {
                                            <span class="badge bg-success-subtle text-success">

                                                <i class="bi bi-arrow-down-circle me-1"></i>

                                                Income

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger">

                                                <i class="bi bi-arrow-up-circle me-1"></i>

                                                Expense

                                            </span>
                                        }

                                    </td>


                                    <!-- Category -->

                                    <td>

                                        <span class="text-nowrap">

                                            @(transaction.Category?.Name ?? "Unknown")

                                        </span>

                                    </td>


                                    <!-- Description -->

                                    <td>

                                        @if (string.IsNullOrWhiteSpace(transaction.Description))
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                        else
                                        {
                                            @transaction.Description
                                        }

                                    </td>


                                    <!-- Amount -->

                                    <td class="text-end pe-4 text-nowrap">

                                        @if (transaction.Type ==
                                            personal_finance_Tracker.Models.TransactionType.Income)
                                        {
                                            <span class="text-success fw-semibold">

                                                + ₹@transaction.Amount.ToString("N2")

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-danger fw-semibold">

                                                - ₹@transaction.Amount.ToString("N2")

                                            </span>
                                        }

                                    </td>
                                    <td class="text-end pe-4">

                                        <div class="btn-group btn-group-sm">

                                            <a asp-controller="Transaction" asp-action="Edit" asp-route-id="@transaction.Id"
                                               class="btn btn-outline-primary">

                                                <i class="bi bi-pencil"></i>

                                            </a>

                                            <a asp-controller="Transaction" asp-action="Delete" asp-route-id="@transaction.Id"
                                               class="btn btn-outline-danger">

                                                <i class="bi bi-trash"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Empty State -->

                <div class="text-center py-5 px-3">

                    <div class="mb-3">

                        <i class="bi bi-receipt-cutoff
                            display-4
                            text-muted">
                        </i>

                    </div>

                    <h5 class="fw-semibold">
                        No transactions found
                    </h5>

                    <p class="text-muted mb-3">
                        There are no transactions matching your current filters.
                    </p>

                    @if (
                        Model.Type.HasValue ||
                        Model.CategoryId.HasValue ||
                        Model.StartDate.HasValue ||
                        Model.EndDate.HasValue ||
                        !string.IsNullOrWhiteSpace(Model.Search)
                    )
                    {
                        <a asp-action="Index" class="btn btn-outline-primary">

                            <i class="bi bi-arrow-counterclockwise me-1"></i>

                            Clear Filters

                        </a>
                    }

                </div>
            }

        </div>

    </div>

    @if (Model.Transactions.Any())
    {
        <div class="text-muted small mt-3">

            Showing
            <strong>@Model.Transactions.Count</strong>
            transactions on this page.

        </div>
    }
    <!-- Pagination -->

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4" aria-label="Transaction pagination">

            <ul class="pagination justify-content-center">

                <!-- Previous -->

                <li class="page-item
                    @(Model.CurrentPage == 1 ? "disabled" : "")">

                    @if (Model.CurrentPage > 1)
                    {
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)"
                           asp-route-type="@Model.Type" asp-route-categoryId="@Model.CategoryId"
                           asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                           asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")" asp-route-search="@Model.Search">

                            <i class="bi bi-chevron-left"></i>
                            Previous

                        </a>
                    }
                    else
                    {
                        <span class="page-link">

                            <i class="bi bi-chevron-left"></i>
                            Previous

                        </span>
                    }

                </li>


                <!-- Page numbers -->

                @for (
                    var i = 1;
                    i <= Model.TotalPages;
                    i++
                )
                {
                    <li class="page-item
                        @(i == Model.CurrentPage
                            ? "active"
                            : "")">

                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-type="@Model.Type"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                           asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")" asp-route-search="@Model.Search">

                            @i

                        </a>

                    </li>
                }


                <!-- Next -->

                <li class="page-item
                    @(Model.CurrentPage == Model.TotalPages
                        ? "disabled"
                        : "")">

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)"
                           asp-route-type="@Model.Type" asp-route-categoryId="@Model.CategoryId"
                           asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                           asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")" asp-route-search="@Model.Search">

                            Next
                            <i class="bi bi-chevron-right"></i>

                        </a>
                    }
                    else
                    {
                        <span class="page-link">

                            Next
                            <i class="bi bi-chevron-right"></i>

                        </span>
                    }

                </li>

            </ul>

        </nav>
    }

</div>