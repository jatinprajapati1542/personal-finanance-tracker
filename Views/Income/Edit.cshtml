@model personal_finance_Tracker.ViewModels.IncomeViewModel

@{
    ViewData["Title"] = "Edit Income";

    var categories =
        ViewBag.Categories
        as List<personal_finance_Tracker.Models.Category>
        ?? new List<personal_finance_Tracker.Models.Category>();
}

<div class="container-fluid">

    <div class="mb-4">

        <h2 class="fw-bold">
            Edit Income
        </h2>

        <p class="text-muted">
            Update your income record
        </p>

    </div>


    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <form asp-action="Edit"
                  asp-route-id="@ViewBag.TransactionId"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="row g-4">

                    <!-- Amount -->

                    <div class="col-md-6">

                        <label asp-for="Amount"
                               class="form-label">
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                ₹
                            </span>

                            <input asp-for="Amount"
                                   class="form-control" />

                        </div>

                        <span asp-validation-for="Amount"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Category -->

                    <div class="col-md-6">

                        <label asp-for="CategoryId"
                               class="form-label">
                        </label>

                        <select asp-for="CategoryId"
                                class="form-select">

                            <option value="">
                                Select Category
                            </option>

                            @foreach (var category in categories)
                            {
                                <option value="@category.Id">
                                    @category.Name
                                </option>
                            }

                        </select>

                        <span asp-validation-for="CategoryId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Date -->

                    <div class="col-md-6">

                        <label asp-for="TransactionDate"
                               class="form-label">
                        </label>

                        <input asp-for="TransactionDate"
                               class="form-control" />

                        <span asp-validation-for="TransactionDate"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Description -->

                    <div class="col-12">

                        <label asp-for="Description"
                               class="form-label">
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4">
                        </textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Buttons -->

                    <div class="col-12">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-save me-1"></i>

                            Update Income

                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary ms-2">

                            Cancel

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}