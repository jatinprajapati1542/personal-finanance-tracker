@model personal_finance_Tracker.ViewModels.IncomeViewModel

@{
    ViewData["Title"] = "Edit Income";

    var categories =
        ViewBag.Categories
        as List<personal_finance_Tracker.Models.Category>
        ?? new List<personal_finance_Tracker.Models.Category>();
}

<div class="container-fluid">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-center
                gap-3
                mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-1">

                <div class="bg-success-subtle text-success rounded-3 p-2">
                    <i class="bi bi-pencil-square fs-5"></i>
                </div>

                <h2 class="fw-bold mb-0">
                    Edit Income
                </h2>

            </div>

            <p class="text-muted mb-0">
                Update the details of your income transaction.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Income

        </a>

    </div>


    <!-- Form Card -->
    <div class="row justify-content-center">

        <div class="col-xl-9 col-lg-10">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-success-subtle border-0 p-4">

                    <div class="d-flex align-items-center gap-3">

                        <div class="bg-success text-white rounded-3
                                    d-flex align-items-center
                                    justify-content-center"
                             style="width: 48px; height: 48px;">

                            <i class="bi bi-pencil-square fs-4"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-1">
                                Update Income Details
                            </h5>

                            <p class="text-muted small mb-0">
                                Modify the information below.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="card-body p-4">

                    <form asp-action="Edit"
                          asp-route-id="@ViewBag.TransactionId"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>


                        <div class="row g-4">

                            <!-- Amount -->
                            <div class="col-md-6">

                                <label asp-for="Amount"
                                       class="form-label fw-semibold">
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text
                                                 bg-success-subtle
                                                 text-success
                                                 border-success-subtle">

                                        ₹

                                    </span>

                                    <input asp-for="Amount"
                                           class="form-control" />

                                </div>

                                <span asp-validation-for="Amount"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- Category -->
                            <div class="col-md-6">

                                <label asp-for="CategoryId"
                                       class="form-label fw-semibold">
                                </label>

                                <select asp-for="CategoryId"
                                        class="form-select">

                                    <option value="">
                                        Select Category
                                    </option>

                                    @foreach (var category in categories)
                                    {
                                        <option value="@category.Id">
                                            @category.Name
                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="CategoryId"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- Date -->
                            <div class="col-md-6">

                                <label asp-for="TransactionDate"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="TransactionDate"
                                       class="form-control" />

                                <span asp-validation-for="TransactionDate"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- Description -->
                            <div class="col-12">

                                <label asp-for="Description"
                                       class="form-label fw-semibold">
                                </label>

                                <textarea asp-for="Description"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Add an optional description..."></textarea>

                                <span asp-validation-for="Description"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- Buttons -->
                            <div class="col-12">

                                <hr class="my-1">

                                <div class="d-flex flex-wrap gap-2 mt-3">

                                    <button type="submit"
                                            class="btn btn-success">

                                        <i class="bi bi-save me-1"></i>
                                        Update Income

                                    </button>

                                    <a asp-action="Index"
                                       class="btn btn-outline-secondary">

                                        Cancel

                                    </a>

                                </div>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}