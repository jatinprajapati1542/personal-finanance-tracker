@model personal_finance_Tracker.ViewModels.CategoryViewModel

@{
    ViewData["Title"] = "Income Categories";

    var categories =
        ViewBag.Categories
        as List<personal_finance_Tracker.Models.Category>
        ?? new List<personal_finance_Tracker.Models.Category>();
}

<div class="container-fluid">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-center
                gap-3
                mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-1">

                <div class="bg-success-subtle text-success rounded-3 p-2">
                    <i class="bi bi-tags fs-5"></i>
                </div>

                <h2 class="fw-bold mb-0">
                    Income Categories
                </h2>

            </div>

            <p class="text-muted mb-0">
                Create and manage categories for your income.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Income

        </a>

    </div>


    <div class="row g-4">

        <!-- Add Category -->
        <div class="col-xl-5 col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-success-subtle border-0 p-4">

                    <div class="d-flex align-items-center gap-3">

                        <div class="bg-success text-white rounded-3
                                    d-flex align-items-center
                                    justify-content-center"
                             style="width: 45px; height: 45px;">

                            <i class="bi bi-plus-lg fs-5"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-1">
                                Add New Category
                            </h5>

                            <p class="text-muted small mb-0">
                                Create a category for your income.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="card-body p-4">

                    <form asp-action="CreateCategory"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>


                        <div class="mb-4">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">
                            </label>

                            <div class="input-group">

                                <span class="input-group-text
                                             bg-success-subtle
                                             text-success
                                             border-success-subtle">

                                    <i class="bi bi-tag"></i>

                                </span>

                                <input asp-for="Name"
                                       class="form-control"
                                       placeholder="Example: Salary" />

                            </div>

                            <span asp-validation-for="Name"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="d-flex flex-wrap gap-2">

                            <button type="submit"
                                    class="btn btn-success">

                                <i class="bi bi-plus-lg me-1"></i>
                                Add Category

                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>


        <!-- Existing Categories -->
        <div class="col-xl-7 col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 p-4">

                    <div class="d-flex justify-content-between
                                align-items-center">

                        <div>

                            <h5 class="fw-bold mb-1">
                                My Income Categories
                            </h5>

                            <p class="text-muted small mb-0">
                                @categories.Count
                                categor@(categories.Count == 1 ? "y" : "ies")
                            </p>

                        </div>

                        <span class="badge bg-success-subtle text-success px-3 py-2">

                            <i class="bi bi-tags me-1"></i>
                            Income

                        </span>

                    </div>

                </div>


                <div class="card-body p-4">

                    @if (categories.Any())
                    {
                        <div class="list-group list-group-flush">

                            @foreach (var category in categories)
                            {
                                <div class="list-group-item px-0
                                            d-flex
                                            justify-content-between
                                            align-items-center">

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="bg-success-subtle
                                                    text-success
                                                    rounded-3
                                                    d-flex
                                                    align-items-center
                                                    justify-content-center"
                                             style="width: 40px; height: 40px;">

                                            <i class="bi bi-tag"></i>

                                        </div>

                                        <div>

                                            <div class="fw-semibold">
                                                @category.Name
                                            </div>

                                            <small class="text-muted">
                                                Income category
                                            </small>

                                        </div>

                                    </div>


                                    <form asp-action="DeleteCategory"
                                          asp-route-id="@category.Id"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this category?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                title="Delete Category">

                                            <i class="bi bi-trash"></i>

                                        </button>

                                    </form>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">

                            <div class="bg-success-subtle
                                        text-success
                                        rounded-circle
                                        d-inline-flex
                                        align-items-center
                                        justify-content-center
                                        mb-3"
                                 style="width: 65px; height: 65px;">

                                <i class="bi bi-tags fs-3"></i>

                            </div>

                            <h6 class="fw-semibold">
                                No income categories yet
                            </h6>

                            <p class="text-muted small mb-0">
                                Create your first income category
                                using the form.
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}