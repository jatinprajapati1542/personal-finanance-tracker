@model IEnumerable<personal_finance_Tracker.Models.Transaction>

@{
    ViewData["Title"] = "Income";

    var categories =
        ViewBag.Categories
        as List<personal_finance_Tracker.Models.Category>
        ?? new List<personal_finance_Tracker.Models.Category>();
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Income</h2>

            <p class="text-muted mb-0">
                Manage your income records
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="CreateCategory" class="btn btn-outline-primary">

                <i class="bi bi-tags me-1"></i>

                Manage Categories

            </a>

            <a asp-action="Create" class="btn btn-success">

                <i class="bi bi-plus-lg me-1"></i>

                Add Income

            </a>

        </div>

    </div>

    <div class="row mb-4">

        <div class="col-md-4">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                Total Income
                            </p>

                            <h3 class="fw-bold text-success mb-0">

                                ₹@Convert.ToDecimal(ViewBag.TotalIncome).ToString("N2")

                            </h3>

                        </div>

                        <div class="fs-2 text-success">

                            <i class="bi bi-arrow-down-circle"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Filters -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="row g-3">

                    <div class="col-md-3">

                        <label class="form-label">
                            Search
                        </label>

                        <input type="text" name="search" value="@ViewBag.Search" class="form-control"
                               placeholder="Search..." />

                    </div>


                    <div class="col-md-2">

                        <label class="form-label">
                            Category
                        </label>

                        <select name="categoryId" class="form-select">

                            <option value="">
                                All Categories
                            </option>

                            @foreach (var category in categories)
                            {
                                <option value="@category.Id"
                                        selected="@(ViewBag.CategoryId != null &&
                                                                                                                                   (int)ViewBag.CategoryId == category.Id)">
                                    @category.Name
                                </option>
                            }

                        </select>

                    </div>


                    <div class="col-md-2">

                        <label class="form-label">
                            Start Date
                        </label>

                        <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control" />

                    </div>


                    <div class="col-md-2">

                        <label class="form-label">
                            End Date
                        </label>

                        <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control" />

                    </div>


                    <div class="col-md-3 d-flex align-items-end gap-2">

                        <button type="submit" class="btn btn-primary">

                            <i class="bi bi-search me-1"></i>

                            Filter

                        </button>

                        <a asp-action="Index" class="btn btn-outline-secondary">

                            Clear

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- Income Table -->

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>Date</th>

                            <th>Category</th>

                            <th>Description</th>

                            <th class="text-end">
                                Amount
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            foreach (var income in Model)
                            {
                                <tr>

                                    <td>
                                        @income.TransactionDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        <span class="badge bg-success-subtle text-success">
                                            @income.Category?.Name
                                        </span>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(income.Description)
                                            ? "-"
                                            : income.Description)
                                    </td>

                                    <td class="text-end fw-semibold text-success">

                                        + ₹@income.Amount.ToString("N2")

                                    </td>

                                    <td class="text-end">

                                        <a asp-action="Edit" asp-route-id="@income.Id" class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-pencil"></i>

                                        </a>


                                        <form asp-action="Delete" asp-route-id="@income.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this income?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit" class="btn btn-sm btn-outline-danger">

                                                <i class="bi bi-trash"></i>

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="5" class="text-center py-5">

                                    <i class="bi bi-cash-stack fs-1 text-muted"></i>

                                    <p class="text-muted mt-3 mb-0">
                                        No income records found.
                                    </p>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>