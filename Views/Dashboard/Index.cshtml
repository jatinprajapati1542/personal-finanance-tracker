@model personal_finance_Tracker.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    <!-- Header -->

    <div class="d-flex justify-content-between
        align-items-center
        flex-wrap
        gap-3
        mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Dashboard
            </h2>

            <p class="text-muted mb-0">
                Here's an overview of your finances.
            </p>

        </div>


        <!-- Quick Actions -->

        <div class="d-flex flex-wrap gap-2">

            <a asp-controller="Income" asp-action="Create" class="btn btn-success">

                <i class="bi bi-plus-circle me-1"></i>

                Add Income

            </a>


            <a asp-controller="Expense" asp-action="Create" class="btn btn-danger">

                <i class="bi bi-plus-circle me-1"></i>

                Add Expense

            </a>

        </div>

    </div>


    <!-- Summary Cards -->

    <div class="row g-4 mb-4">

        <!-- Income -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Total Income
                            </p>

                            <h3 class="fw-bold text-success mb-0">
                                ₹@Model.TotalIncome.ToString("N2")
                            </h3>

                        </div>

                        <div class="rounded-circle
                            bg-success-subtle
                            text-success
                            p-3">

                            <i class="bi bi-arrow-down-circle fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Expense -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Total Expenses
                            </p>

                            <h3 class="fw-bold text-danger mb-0">
                                ₹@Model.TotalExpense.ToString("N2")
                            </h3>

                        </div>

                        <div class="rounded-circle
                            bg-danger-subtle
                            text-danger
                            p-3">

                            <i class="bi bi-arrow-up-circle fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Balance -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Balance
                            </p>

                            <h3 class="fw-bold mb-0
                                @(Model.Balance >= 0
                                    ? "text-primary"
                                    : "text-danger")">

                                ₹@Model.Balance.ToString("N2")

                            </h3>

                        </div>

                        <div class="rounded-circle
                            bg-primary-subtle
                            text-primary
                            p-3">

                            <i class="bi bi-wallet2 fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Transactions -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Transactions
                            </p>

                            <h3 class="fw-bold mb-0">
                                @Model.TotalTransactions
                            </h3>

                        </div>

                        <div class="rounded-circle
                            bg-secondary-subtle
                            text-secondary
                            p-3">

                            <i class="bi bi-receipt fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Chart + Recent Transactions -->

    <div class="row g-4">

        <!-- Chart -->

        <div class="col-lg-5">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        align-items-center
                        mb-3">

                        <h5 class="fw-bold mb-0">
                            Income vs Expense
                        </h5>

                    </div>

                    <div style="height:300px;">

                        <canvas id="incomeExpenseChart">
                        </canvas>

                    </div>

                </div>

            </div>

        </div>


        <!-- Recent Transactions -->

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-0">

                    <div class="d-flex
                        justify-content-between
                        align-items-center
                        p-4">

                        <h5 class="fw-bold mb-0">
                            Recent Transactions
                        </h5>

                        <a asp-controller="Transaction" asp-action="Index" class="btn btn-sm btn-outline-primary">

                            View All

                        </a>

                    </div>


                    @if (Model.RecentTransactions.Any())
                    {
                        <div class="table-responsive">

                            <table class="table table-hover
                                align-middle mb-0">

                                <thead class="table-light">

                                    <tr>

                                        <th class="ps-4">
                                            Date
                                        </th>

                                        <th>
                                            Type
                                        </th>

                                        <th>
                                            Category
                                        </th>

                                        <th class="text-end pe-4">
                                            Amount
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    @foreach (var transaction
                                        in Model.RecentTransactions)
                                    {
                                        <tr>

                                            <td class="ps-4">

                                                @transaction.TransactionDate.ToString("dd MMM yyyy")

                                            </td>


                                            <td>

                                                @if (transaction.Type == personal_finance_Tracker.Models.TransactionType.Income)
                                                {
                                                    <span class="badge
                                                        bg-success-subtle
                                                        text-success">

                                                        <i class="bi
                                                        bi-arrow-down
                                                        me-1"></i>

                                                        Income

                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge
                                                        bg-danger-subtle
                                                        text-danger">

                                                        <i class="bi
                                                        bi-arrow-up
                                                        me-1"></i>

                                                        Expense

                                                    </span>
                                                }

                                            </td>


                                            <td>

                                                @(transaction.Category?.Name ?? "-")

                                            </td>


                                            <td class="text-end pe-4">

                                                @if (transaction.Type ==
                                                    personal_finance_Tracker.Models.TransactionType.Income)
                                                {
                                                    <span class="text-success
                                                        fw-semibold">

                                                        + ₹@transaction.Amount.ToString("N2")

                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-danger
                                                        fw-semibold">

                                                        - ₹@transaction.Amount.ToString("N2")

                                                    </span>
                                                }

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 px-3">

                            <i class="bi bi-receipt
                            fs-1
                            text-muted"></i>

                            <h6 class="mt-3">
                                No transactions yet
                            </h6>

                            <p class="text-muted mb-3">
                                Add your first income or expense.
                            </p>

                            <a asp-controller="Income" asp-action="Create" class="btn btn-primary">

                                Add Transaction

                            </a>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <!-- Chart.js -->

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


    <script>

        const income = @Model.ChartIncome;
        const expense = @Model.ChartExpense;

        const ctx =
        document.getElementById('incomeExpenseChart');


        new Chart(ctx, {

        type: 'doughnut',

        data: {

        labels: [
        'Income',
        'Expense'
        ],

        datasets: [{

        data: [
        income,
        expense
        ]

        }]

        },

        options: {

        responsive: true,

        maintainAspectRatio: false,

        plugins: {

        legend: {

        position: 'bottom'

        }

        }

        }

        });

    </script>
}