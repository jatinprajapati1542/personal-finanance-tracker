@model personal_finance_Tracker.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    var budgetPercentage = Model.TotalBudget > 0
        ? (Model.TotalBudgetSpent / Model.TotalBudget) * 100
        : 0;

    var budgetProgress = Math.Min(budgetPercentage, 100);

    var budgetProgressClass =
        budgetPercentage >= 100
            ? "bg-danger"
            : budgetPercentage >= 80
                ? "bg-warning"
                : "bg-success";

    var currentMonth = DateTime.Today.ToString("MMMM yyyy");
}


<div class="container-fluid">


    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Dashboard
            </h2>

            <p class="text-muted mb-0">
                Here's an overview of your finances.
            </p>

        </div>


        <div class="d-flex flex-wrap gap-2">

            <a asp-controller="Income"
               asp-action="Create"
               class="btn btn-success">

                <i class="bi bi-plus-circle me-1"></i>

                Add Income

            </a>


            <a asp-controller="Expense"
               asp-action="Create"
               class="btn btn-danger">

                <i class="bi bi-plus-circle me-1"></i>

                Add Expense

            </a>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- OVERALL SUMMARY -->
    <!-- ===================================================== -->

    <div class="row g-4 mb-4">


        <!-- TOTAL INCOME -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Total Income
                            </p>

                            <h3 class="fw-bold text-success mb-0">
                                ₹@Model.TotalIncome.ToString("N2")
                            </h3>

                        </div>


                        <div class="rounded-circle bg-success-subtle text-success p-3">

                            <i class="bi bi-arrow-down-circle fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- TOTAL EXPENSE -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Total Expenses
                            </p>

                            <h3 class="fw-bold text-danger mb-0">
                                ₹@Model.TotalExpense.ToString("N2")
                            </h3>

                        </div>


                        <div class="rounded-circle bg-danger-subtle text-danger p-3">

                            <i class="bi bi-arrow-up-circle fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- BALANCE -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Balance
                            </p>

                            <h3 class="fw-bold
                                @(Model.Balance >= 0
                                    ? "text-primary"
                                    : "text-danger") mb-0">

                                ₹@Model.Balance.ToString("N2")

                            </h3>

                        </div>


                        <div class="rounded-circle bg-primary-subtle text-primary p-3">

                            <i class="bi bi-wallet2 fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- TRANSACTIONS -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Transactions
                            </p>

                            <h3 class="fw-bold mb-0">
                                @Model.TotalTransactions
                            </h3>

                        </div>


                        <div class="rounded-circle bg-secondary-subtle text-secondary p-3">

                            <i class="bi bi-receipt fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- CURRENT MONTH -->
    <!-- ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>

                    <h5 class="fw-bold mb-1">
                        @currentMonth
                    </h5>

                    <p class="text-muted small mb-0">
                        Your financial activity this month
                    </p>

                </div>

            </div>


            <div class="row g-4">


                <!-- MONTHLY INCOME -->

                <div class="col-lg-3 col-md-6">

                    <div class="border rounded p-3 h-100">

                        <div class="d-flex justify-content-between">

                            <span class="text-muted">
                                Income
                            </span>

                            <i class="bi bi-arrow-down-circle text-success"></i>

                        </div>

                        <h4 class="fw-bold text-success mt-2 mb-0">

                            ₹@Model.CurrentMonthIncome.ToString("N2")

                        </h4>

                    </div>

                </div>


                <!-- MONTHLY EXPENSE -->

                <div class="col-lg-3 col-md-6">

                    <div class="border rounded p-3 h-100">

                        <div class="d-flex justify-content-between">

                            <span class="text-muted">
                                Expenses
                            </span>

                            <i class="bi bi-arrow-up-circle text-danger"></i>

                        </div>

                        <h4 class="fw-bold text-danger mt-2 mb-0">

                            ₹@Model.CurrentMonthExpense.ToString("N2")

                        </h4>

                    </div>

                </div>


                <!-- MONTHLY BALANCE -->

                <div class="col-lg-3 col-md-6">

                    <div class="border rounded p-3 h-100">

                        <div class="d-flex justify-content-between">

                            <span class="text-muted">
                                Balance
                            </span>

                            <i class="bi bi-wallet2 text-primary"></i>

                        </div>

                        <h4 class="fw-bold
                            @(Model.CurrentMonthBalance >= 0
                                ? "text-primary"
                                : "text-danger") mt-2 mb-0">

                            ₹@Model.CurrentMonthBalance.ToString("N2")

                        </h4>

                    </div>

                </div>


                <!-- SAVINGS RATE -->

                <div class="col-lg-3 col-md-6">

                    <div class="border rounded p-3 h-100">

                        <div class="d-flex justify-content-between">

                            <span class="text-muted">
                                Savings Rate
                            </span>

                            <i class="bi bi-piggy-bank text-success"></i>

                        </div>

                        <h4 class="fw-bold text-success mt-2 mb-0">

                            @Model.SavingsRate.ToString("N1")%

                        </h4>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- CHARTS -->
    <!-- ===================================================== -->

    <div class="row g-4 mb-4">


        <!-- INCOME VS EXPENSE -->

        <div class="col-lg-5">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="mb-3">

                        <h5 class="fw-bold mb-1">
                            Income vs Expense
                        </h5>

                        <p class="text-muted small mb-0">
                            Overall financial distribution
                        </p>

                    </div>


                    <div style="height:300px;">

                        <canvas id="incomeExpenseChart"></canvas>

                    </div>

                </div>

            </div>

        </div>


        <!-- MONTHLY CHART -->

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="mb-3">

                        <h5 class="fw-bold mb-1">
                            Monthly Income & Expense
                        </h5>

                        <p class="text-muted small mb-0">
                            Financial activity over the last 6 months
                        </p>

                    </div>


                    <div style="height:300px;">

                        <canvas id="monthlyFinanceChart"></canvas>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- BUDGET + RECENT TRANSACTIONS -->
    <!-- ===================================================== -->

    <div class="row g-4 mb-4">


        <!-- BUDGET SUMMARY -->

        <div class="col-lg-5">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div>

                            <h5 class="fw-bold mb-1">
                                Monthly Budget
                            </h5>

                            <p class="text-muted small mb-0">
                                @currentMonth
                            </p>

                        </div>


                        <a asp-controller="Budget"
                           asp-action="Index"
                           class="btn btn-sm btn-outline-primary">

                            Manage

                        </a>

                    </div>


                    @if (Model.TotalBudget > 0)
                    {

                        <div class="row g-3 mb-4">


                            <div class="col-4">

                                <div class="bg-light rounded p-3">

                                    <small class="text-muted">
                                        Budget
                                    </small>

                                    <div class="fw-bold mt-1">
                                        ₹@Model.TotalBudget.ToString("N0")
                                    </div>

                                </div>

                            </div>


                            <div class="col-4">

                                <div class="bg-light rounded p-3">

                                    <small class="text-muted">
                                        Spent
                                    </small>

                                    <div class="fw-bold text-danger mt-1">
                                        ₹@Model.TotalBudgetSpent.ToString("N0")
                                    </div>

                                </div>

                            </div>


                            <div class="col-4">

                                <div class="bg-light rounded p-3">

                                    <small class="text-muted">
                                        Left
                                    </small>

                                    <div class="fw-bold
                                        @(Model.TotalBudgetRemaining >= 0
                                            ? "text-success"
                                            : "text-danger") mt-1">

                                        ₹@Model.TotalBudgetRemaining.ToString("N0")

                                    </div>

                                </div>

                            </div>

                        </div>


                        <div class="d-flex justify-content-between mb-2">

                            <span class="small fw-semibold">
                                Budget Usage
                            </span>

                            <span class="small fw-semibold">
                                @budgetPercentage.ToString("N0")%
                            </span>

                        </div>


                        <div class="progress mb-3"
                             style="height:10px;">

                            <div class="progress-bar @budgetProgressClass"
                                 style="width:@budgetProgress%;">

                            </div>

                        </div>


                        @if (budgetPercentage >= 100)
                        {

                            <div class="alert alert-danger mb-0">

                                <i class="bi bi-exclamation-triangle-fill me-2"></i>

                                Your budget has been exceeded.

                            </div>

                        }
                        else if (budgetPercentage >= 80)
                        {

                            <div class="alert alert-warning mb-0">

                                <i class="bi bi-exclamation-circle-fill me-2"></i>

                                You are approaching your budget limit.

                            </div>

                        }
                        else
                        {

                            <div class="alert alert-success mb-0">

                                <i class="bi bi-check-circle-fill me-2"></i>

                                Your spending is under control.

                            </div>

                        }

                    }
                    else
                    {

                        <div class="text-center py-4">

                            <i class="bi bi-piggy-bank fs-1 text-muted"></i>

                            <h6 class="mt-3">
                                No budget set
                            </h6>

                            <p class="text-muted small">
                                Create a budget to track your spending.
                            </p>

                            <a asp-controller="Budget"
                               asp-action="Create"
                               class="btn btn-primary">

                                <i class="bi bi-plus-circle me-1"></i>

                                Create Budget

                            </a>

                        </div>

                    }

                </div>

            </div>

        </div>


        <!-- RECENT TRANSACTIONS -->

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-0">

                    <div class="d-flex justify-content-between align-items-center p-4">

                        <div>

                            <h5 class="fw-bold mb-1">
                                Recent Transactions
                            </h5>

                            <p class="text-muted small mb-0">
                                Latest financial activity
                            </p>

                        </div>


                        <a asp-controller="Transaction"
                           asp-action="Index"
                           class="btn btn-sm btn-outline-primary">

                            View All

                        </a>

                    </div>


                    @if (Model.RecentTransactions.Any())
                    {

                        <div class="table-responsive">

                            <table class="table table-hover align-middle mb-0">

                                <thead class="table-light">

                                    <tr>

                                        <th class="ps-4">
                                            Date
                                        </th>

                                        <th>
                                            Category
                                        </th>

                                        <th>
                                            Type
                                        </th>

                                        <th class="text-end pe-4">
                                            Amount
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    @foreach (var transaction in Model.RecentTransactions)
                                    {

                                        <tr>

                                            <td class="ps-4">

                                                <small>

                                                    @transaction.TransactionDate.ToString("dd MMM")

                                                </small>

                                            </td>


                                            <td>

                                                @(transaction.Category?.Name ?? "-")

                                            </td>


                                            <td>

                                                @if (transaction.Type ==
                                                    personal_finance_Tracker.Models.TransactionType.Income)
                                                {

                                                    <span class="badge bg-success-subtle text-success">

                                                        <i class="bi bi-arrow-down me-1"></i>

                                                        Income

                                                    </span>

                                                }
                                                else
                                                {

                                                    <span class="badge bg-danger-subtle text-danger">

                                                        <i class="bi bi-arrow-up me-1"></i>

                                                        Expense

                                                    </span>

                                                }

                                            </td>


                                            <td class="text-end pe-4">

                                                @if (transaction.Type ==
                                                    personal_finance_Tracker.Models.TransactionType.Income)
                                                {

                                                    <span class="text-success fw-semibold">

                                                        + ₹@transaction.Amount.ToString("N2")

                                                    </span>

                                                }
                                                else
                                                {

                                                    <span class="text-danger fw-semibold">

                                                        - ₹@transaction.Amount.ToString("N2")

                                                    </span>

                                                }

                                            </td>

                                        </tr>

                                    }

                                </tbody>

                            </table>

                        </div>

                    }
                    else
                    {

                        <div class="text-center py-5 px-3">

                            <i class="bi bi-receipt fs-1 text-muted"></i>

                            <h6 class="mt-3">
                                No transactions yet
                            </h6>

                            <p class="text-muted mb-3">
                                Add your first income or expense.
                            </p>

                            <a asp-controller="Income"
                               asp-action="Create"
                               class="btn btn-primary">

                                Add Transaction

                            </a>

                        </div>

                    }

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- BUDGET CATEGORY OVERVIEW -->
    <!-- ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>

                    <h5 class="fw-bold mb-1">
                        Budget Overview
                    </h5>

                    <p class="text-muted small mb-0">
                        Track spending by category
                    </p>

                </div>


                <a asp-controller="Budget"
                   asp-action="Index"
                   class="btn btn-sm btn-outline-primary">

                    View All

                </a>

            </div>


            @if (Model.Budgets.Any())
            {

                <div class="row g-4">

                    @foreach (var budget in Model.Budgets)
                    {

                        var percentage = Math.Min(
                            budget.Percentage,
                            100);

                        <div class="col-xl-4 col-md-6">

                            <div class="border rounded p-3 h-100">


                                <!-- CATEGORY -->

                                <div class="d-flex justify-content-between align-items-center mb-3">

                                    <strong>
                                        @budget.CategoryName
                                    </strong>


                                    @if (budget.Status == "Exceeded")
                                    {

                                        <span class="badge bg-danger-subtle text-danger">

                                            <i class="bi bi-exclamation-triangle me-1"></i>

                                            Exceeded

                                        </span>

                                    }
                                    else if (budget.Status == "Warning")
                                    {

                                        <span class="badge bg-warning-subtle text-warning">

                                            <i class="bi bi-exclamation-circle me-1"></i>

                                            Warning

                                        </span>

                                    }
                                    else
                                    {

                                        <span class="badge bg-success-subtle text-success">

                                            <i class="bi bi-check-circle me-1"></i>

                                            Healthy

                                        </span>

                                    }

                                </div>


                                <!-- AMOUNTS -->

                                <div class="d-flex justify-content-between mb-2">

                                    <small class="text-muted">

                                        ₹@budget.SpentAmount.ToString("N2")
                                        /
                                        ₹@budget.BudgetAmount.ToString("N2")

                                    </small>


                                    <small class="fw-semibold">

                                        @budget.Percentage.ToString("N0")%

                                    </small>

                                </div>


                                <!-- PROGRESS -->

                                <div class="progress"
                                     style="height:8px;">

                                    <div class="progress-bar @budget.ProgressClass"
                                         style="width:@percentage%;">

                                    </div>

                                </div>


                                <!-- REMAINING -->

                                @if (budget.RemainingAmount >= 0)
                                {

                                    <small class="text-muted d-block mt-2">

                                        ₹@budget.RemainingAmount.ToString("N2")
                                        remaining

                                    </small>

                                }
                                else
                                {

                                    <small class="text-danger d-block mt-2">

                                        ₹@Math.Abs(
                                            budget.RemainingAmount
                                        ).ToString("N2")
                                        over budget

                                    </small>

                                }

                            </div>

                        </div>

                    }

                </div>

            }
            else
            {

                <div class="text-center py-4">

                    <i class="bi bi-piggy-bank fs-1 text-muted"></i>

                    <h6 class="mt-3">
                        No budgets available
                    </h6>

                    <p class="text-muted">
                        Create a budget to monitor your spending.
                    </p>

                    <a asp-controller="Budget"
                       asp-action="Create"
                       class="btn btn-primary">

                        <i class="bi bi-plus-circle me-1"></i>

                        Create Budget

                    </a>

                </div>

            }

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- CHART.JS -->
<!-- ========================================================= -->

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


    <script>

        // =====================================================
        // DATA
        // =====================================================

        const income = @Model.ChartIncome;
        const expense = @Model.ChartExpense;


        const chartMonths =
            @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    Model.ChartMonths
                )
            );


        const monthlyIncome =
            @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    Model.MonthlyIncome
                )
            );


        const monthlyExpense =
            @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    Model.MonthlyExpense
                )
            );


        // =====================================================
        // INCOME VS EXPENSE
        // =====================================================

        const incomeExpenseCanvas =
            document.getElementById("incomeExpenseChart");


        if (incomeExpenseCanvas) {

            new Chart(incomeExpenseCanvas, {

                type: "doughnut",

                data: {

                    labels: [
                        "Income",
                        "Expense"
                    ],

                    datasets: [{

                        data: [
                            income,
                            expense
                        ],

                        borderWidth: 0

                    }]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    cutout: "68%",

                    plugins: {

                        legend: {

                            position: "bottom",

                            labels: {

                                padding: 20

                            }

                        },

                        tooltip: {

                            callbacks: {

                                label: function (context) {

                                    return context.label +
                                        ": ₹" +
                                        Number(context.raw)
                                            .toLocaleString("en-IN");

                                }

                            }

                        }

                    }

                }

            });

        }


        // =====================================================
        // MONTHLY INCOME VS EXPENSE
        // =====================================================

        const monthlyFinanceCanvas =
            document.getElementById("monthlyFinanceChart");


        if (monthlyFinanceCanvas) {

            new Chart(monthlyFinanceCanvas, {

                type: "bar",

                data: {

                    labels: chartMonths,

                    datasets: [

                        {

                            label: "Income",

                            data: monthlyIncome,

                            borderWidth: 1

                        },

                        {

                            label: "Expense",

                            data: monthlyExpense,

                            borderWidth: 1

                        }

                    ]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    scales: {

                        y: {

                            beginAtZero: true,

                            ticks: {

                                callback: function (value) {

                                    return "₹" +
                                        Number(value)
                                            .toLocaleString("en-IN");

                                }

                            }

                        }

                    },

                    plugins: {

                        legend: {

                            position: "bottom"

                        },

                        tooltip: {

                            callbacks: {

                                label: function (context) {

                                    return context.dataset.label +
                                        ": ₹" +
                                        Number(context.raw)
                                            .toLocaleString("en-IN");

                                }

                            }

                        }

                    }

                }

            });

        }

    </script>

}