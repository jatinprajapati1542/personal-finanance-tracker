@model IEnumerable<personal_finance_Tracker.ViewModels.BudgetViewModel>

@{
    ViewData["Title"] = "Budgets";

    // -------------------------------
    // Overall summary
    // -------------------------------

    var totalBudget = Model.Sum(x => x.Amount);

    var totalSpent = Model.Sum(x => x.Spent);

    var totalRemaining = totalBudget - totalSpent;

    var overallPercentage = totalBudget > 0
        ? (totalSpent / totalBudget) * 100
        : 0;

    var progressPercentage = Math.Min(overallPercentage, 100);


    // -------------------------------
    // Budget status
    // -------------------------------

    var exceededBudgets = Model
        .Where(x => x.Percentage >= 100)
        .ToList();

    var warningBudgets = Model
        .Where(x => x.Percentage >= 80 && x.Percentage < 100)
        .ToList();

    var healthyBudgets = Model
        .Where(x => x.Percentage < 80)
        .ToList();
}

<div class="container-fluid">

    <!-- Header -->

    <div class="d-flex justify-content-between
        align-items-center mb-4 flex-wrap gap-3">

        <div>

            <h2 class="fw-bold mb-1">
                Budgets
            </h2>

            <p class="text-muted mb-0">
                Monitor and control your monthly spending.
            </p>

        </div>

        <div class="d-flex gap-2">

            <!-- Month Filter -->

            <form asp-action="Index" method="get" class="d-flex gap-2">

                <input type="month" name="month" class="form-control"
                       value="@(((DateTime)ViewBag.SelectedMonth).ToString("yyyy-MM"))" />

                <button type="submit" class="d-flex btn btn-outline-primary">

                    <i class="bi bi-filter me-1"></i>
                    Filter

                </button>

            </form>


            <!-- Create -->

            <a asp-action="Create" class="btn btn-primary">

                <i class="bi bi-plus-circle me-1"></i>
                Create Budget

            </a>

        </div>

    </div>

    <div class="mb-4">

        <span class="badge bg-primary-subtle text-primary px-3 py-2">

            <i class="bi bi-calendar3 me-1"></i>

            @(((DateTime)ViewBag.SelectedMonth).ToString("MMMM yyyy"))

        </span>

    </div>


    <div class="row g-3 mb-4">

        <div class="col-md-4">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="bg-success bg-opacity-10
                            text-success rounded-circle p-3 me-3">

                            <i class="bi bi-check-circle fs-5"></i>

                        </div>

                        <div>

                            <small class="text-muted">
                                On Track
                            </small>

                            <h4 class="fw-bold mb-0">
                                @healthyBudgets.Count
                            </h4>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="bg-warning bg-opacity-10
                            text-warning rounded-circle p-3 me-3">

                            <i class="bi bi-exclamation-circle fs-5"></i>

                        </div>

                        <div>

                            <small class="text-muted">
                                Almost Reached
                            </small>

                            <h4 class="fw-bold mb-0">
                                @warningBudgets.Count
                            </h4>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="bg-danger bg-opacity-10
                            text-danger rounded-circle p-3 me-3">

                            <i class="bi bi-exclamation-triangle fs-5"></i>

                        </div>

                        <div>

                            <small class="text-muted">
                                Exceeded
                            </small>

                            <h4 class="fw-bold mb-0">
                                @exceededBudgets.Count
                            </h4>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Success Message -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button" class="btn-close" data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (!Model.Any())
    {
        <!-- Empty State -->

        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <i class="bi bi-pie-chart text-primary" style="font-size: 60px;">
                </i>

                <h4 class="fw-bold mt-3">
                    No budgets yet
                </h4>

                <p class="text-muted">
                    Create your first budget to start
                    managing your spending.
                </p>

                <a asp-action="Create" class="btn btn-primary mt-2">

                    <i class="bi bi-plus-circle me-1"></i>
                    Create Your First Budget

                </a>

            </div>

        </div>
    }
    else
    {

        <!-- ====================================== -->
        <!-- SUMMARY CARDS -->
        <!-- ====================================== -->

        <div class="row g-4 mb-4">

            <!-- Total Budget -->

            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body p-4">

                        <div class="d-flex
                            justify-content-between
                            align-items-center">

                            <div>

                                <p class="text-muted mb-1">
                                    Total Budget
                                </p>

                                <h3 class="fw-bold mb-0">

                                    ₹@totalBudget.ToString("N2")

                                </h3>

                            </div>

                            <div class="bg-primary bg-opacity-10
                                text-primary rounded-circle
                                p-3">

                                <i class="bi bi-wallet2 fs-4"></i>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Total Spent -->

            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body p-4">

                        <div class="d-flex
                            justify-content-between
                            align-items-center">

                            <div>

                                <p class="text-muted mb-1">
                                    Total Spent
                                </p>

                                <h3 class="fw-bold mb-0">

                                    ₹@totalSpent.ToString("N2")

                                </h3>

                            </div>

                            <div class="bg-danger bg-opacity-10
                                text-danger rounded-circle
                                p-3">

                                <i class="bi bi-arrow-down-circle fs-4"></i>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Remaining -->

            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body p-4">

                        <div class="d-flex
                            justify-content-between
                            align-items-center">

                            <div>

                                <p class="text-muted mb-1">
                                    Remaining
                                </p>

                                <h3 class="fw-bold mb-0
                                    @(totalRemaining >= 0
                                        ? "text-success"
                                        : "text-danger")">

                                    ₹@Math.Abs(totalRemaining).ToString("N2")

                                </h3>

                                @if (totalRemaining < 0)
                                {
                                    <small class="text-danger">
                                        Over budget
                                    </small>
                                }

                            </div>

                            <div class="bg-success bg-opacity-10
                                text-success rounded-circle
                                p-3">

                                <i class="bi bi-cash-stack fs-4"></i>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

         @if (exceededBudgets.Any())
            {
                <div class="alert alert-danger border-0 shadow-sm">

                    <div class="d-flex align-items-start">

                        <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>

                        <div>

                            <h6 class="fw-bold mb-1">
                                Budget Alert
                            </h6>

                            <p class="mb-0">

                                You have
                                <strong>
                                    @exceededBudgets.Count
                                </strong>
                                budget(s) that have been exceeded.

                            </p>

                        </div>

                    </div>

                </div>
            }

            @if (warningBudgets.Any())
            {
                <div class="alert alert-warning border-0 shadow-sm">

                    <div class="d-flex align-items-start">

                        <i class="bi bi-exclamation-circle-fill fs-4 me-3"></i>

                        <div>

                            <h6 class="fw-bold mb-1">
                                Spending Warning
                            </h6>

                            <p class="mb-0">

                                <strong>
                                    @warningBudgets.Count
                                </strong>
                                budget(s) have reached 80% or more.

                            </p>

                        </div>

                    </div>

                </div>
            }


        <!-- ====================================== -->
        <!-- OVERALL PROGRESS -->
        <!-- ====================================== -->

        <div class="card border-0 shadow-sm mb-4">

            <div class="card-body p-4">

                <div class="d-flex
                    justify-content-between
                    align-items-center mb-2">

                    <div>

                        <h5 class="fw-bold mb-1">
                            Overall Budget Usage
                        </h5>

                        <small class="text-muted">

                            ₹@totalSpent.ToString("N2")
                            spent out of
                            ₹@totalBudget.ToString("N2")

                        </small>

                    </div>

                    <strong>

                        @overallPercentage.ToString("0")%

                    </strong>

                </div>


                <div class="progress" style="height: 12px;">

                    <div class="progress-bar
                        @(overallPercentage >= 100
                              ? "bg-danger"
                              : overallPercentage >= 80
                                  ? "bg-warning"
                                  : "bg-success")" style="width: @progressPercentage%;">

                    </div>

                </div>


                <div class="d-flex
                    justify-content-between
                    mt-2">

                    @if (totalRemaining >= 0)
                    {
                        <small class="text-success">

                            ₹@totalRemaining.ToString("N2")
                            remaining

                        </small>
                    }
                    else
                    {
                        <small class="text-danger">

                            ₹@Math.Abs(totalRemaining).ToString("N2")
                            over budget

                        </small>
                    }

                </div>

            </div>

        </div>


        <!-- ====================================== -->
        <!-- BUDGETS -->
        <!-- ====================================== -->

        <div class="d-flex
            justify-content-between
            align-items-center mb-3">

            <h4 class="fw-bold mb-0">
                Your Budgets
            </h4>

            <span class="badge bg-light text-dark">

                @Model.Count() budgets

            </span>

        </div>


        <div class="row g-4">

            @foreach (var budget in Model)
            {
                var progress = Math.Min(
                    budget.Percentage,
                    100);

                var progressClass =
                    budget.Percentage >= 100
                        ? "bg-danger"
                        : budget.Percentage >= 80
                            ? "bg-warning"
                            : "bg-success";


                <div class="col-md-6 col-xl-4">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body p-4">

                            <!-- Card Header -->

                            <div class="d-flex
                                justify-content-between
                                align-items-start mb-3">

                                <div>

                                    <h5 class="fw-bold mb-1">

                                        <i class="bi bi-wallet2
                                            text-primary me-1">
                                        </i>

                                        @budget.CategoryName

                                    </h5>

                                    <small class="text-muted">

                                        @budget.Month.ToString("MMMM yyyy")

                                    </small>

                                </div>


                                <!-- Menu -->

                                <div class="dropdown">

                                    <button class="btn btn-sm btn-light" type="button" data-bs-toggle="dropdown">

                                        <i class="bi bi-three-dots"></i>

                                    </button>

                                    <ul class="dropdown-menu
                                        dropdown-menu-end">

                                        <li>

                                            <a class="dropdown-item" asp-action="Edit" asp-route-id="@budget.Id">

                                                <i class="bi bi-pencil me-2"></i>
                                                Edit

                                            </a>

                                        </li>

                                        <li>

                                            <form asp-action="Delete" asp-route-id="@budget.Id" method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit" class="dropdown-item text-danger"
                                                        onclick="return confirm('Are you sure you want to delete this budget?');">

                                                    <i class="bi bi-trash me-2"></i>
                                                    Delete

                                                </button>

                                            </form>

                                        </li>

                                    </ul>

                                </div>

                            </div>


                            <!-- Budget Amount -->

                            <div class="mb-3">

                                <small class="text-muted">
                                    Budget limit
                                </small>

                                <h4 class="fw-bold mb-0">

                                    ₹@budget.Amount.ToString("N2")

                                </h4>

                            </div>


                            <!-- Progress -->

                            <div class="progress" style="height: 9px;">

                                <div class="progress-bar @progressClass" style="width: @progress%;">

                                </div>

                            </div>


                            <div class="d-flex
                                justify-content-between
                                mt-2">

                                <small class="text-muted">

                                    Spent:
                                    ₹@budget.Spent.ToString("N2")

                                </small>

                                <small class="fw-semibold">

                                    @budget.Percentage.ToString("0")%

                                </small>

                            </div>


                            <hr />


                            <!-- Remaining -->

                            <div class="d-flex
                                justify-content-between
                                align-items-center">

                                <span class="text-muted">
                                    Remaining
                                </span>

                                @if (budget.Remaining >= 0)
                                {
                                    <span class="fw-bold text-success">

                                        ₹@budget.Remaining.ToString("N2")

                                    </span>
                                }
                                else
                                {
                                    <span class="fw-bold text-danger">

                                        Over by
                                        ₹@Math.Abs(
                                                                                                                            budget.Remaining
                                                                                                                        ).ToString("N2")

                                    </span>
                                }

                            </div>


                            <!-- Status -->

                            <div class="mt-3">

                                @if (budget.Percentage >= 100)
                                {
                                    <span class="badge
                                        bg-danger-subtle
                                        text-danger">

                                        <i class="bi bi-exclamation-triangle me-1"></i>
                                        Budget Exceeded

                                    </span>
                                }
                                else if (budget.Percentage >= 80)
                                {
                                    <span class="badge
                                        bg-warning-subtle
                                        text-warning-emphasis">

                                        <i class="bi bi-exclamation-circle me-1"></i>
                                        Almost Reached

                                    </span>
                                }
                                else
                                {
                                    <span class="badge
                                        bg-success-subtle
                                        text-success">

                                        <i class="bi bi-check-circle me-1"></i>
                                        On Track

                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>

    }

</div>