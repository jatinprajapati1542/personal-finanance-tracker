@using Microsoft.AspNetCore.Identity
@using personal_finance_Tracker.Models
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - FinTrack
    </title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Application CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

</head>

<body>

    <div class="app-wrapper">

        <!-- ================= SIDEBAR ================= -->

        <aside id="sidebar" class="sidebar">

            <!-- Brand -->

            <div class="sidebar-header">

                <a asp-controller="Dashboard" asp-action="Index" class="sidebar-brand">

                    <div class="brand-icon">
                        <i class="bi bi-wallet2"></i>
                    </div>

                    <div class="brand-content">

                        <span class="brand-name">
                            FinTrack
                        </span>

                        <small>
                            Personal Finance
                        </small>

                    </div>

                </a>

            </div>


            <!-- Navigation -->

            <nav class="sidebar-nav">

                <div class="nav-section-title">
                    MENU
                </div>


                <!-- Dashboard -->

                <a asp-controller="Dashboard" asp-action="Index" class="sidebar-link">

                    <span class="nav-icon">
                        <i class="bi bi-grid-1x2-fill"></i>
                    </span>

                    <span class="nav-text">
                        Dashboard
                    </span>

                </a>


                <!-- Income -->

                <a asp-controller="Income" asp-action="Index" class="sidebar-link">

                    <span class="nav-icon">
                        <i class="bi bi-arrow-down-circle"></i>
                    </span>

                    <span class="nav-text">
                        Income
                    </span>

                </a>


                <!-- Expenses -->

                <a asp-controller="Expense" asp-action="Index" class="sidebar-link">

                    <span class="nav-icon">
                        <i class="bi bi-arrow-up-circle"></i>
                    </span>

                    <span class="nav-text">
                        Expenses
                    </span>

                </a>


                <!-- Budget -->

                <a asp-controller="Budget" asp-action="Index" class="sidebar-link">

                    <span class="nav-icon">
                        <i class="bi bi-pie-chart"></i>
                    </span>

                    <span class="nav-text">
                        Budget
                    </span>

                </a>


                <!-- Transactions -->

                <a asp-controller="Transaction" asp-action="Index" class="sidebar-link">

                    <span class="nav-icon">
                        <i class="bi bi-receipt"></i>
                    </span>

                    <span class="nav-text">
                        Transactions
                    </span>

                </a>


                <!-- Reports -->

                <a asp-controller="Reports" asp-action="Index" class="sidebar-link">

                    <span class="nav-icon">
                        <i class="bi bi-bar-chart-line"></i>
                    </span>

                    <span class="nav-text">
                        Reports
                    </span>

                </a>


                <div class="sidebar-divider"></div>


                <div class="nav-section-title">
                    ACCOUNT
                </div>


                <!-- Profile -->

                <a asp-controller="Profile" asp-action="Index" class="sidebar-link">

                    <span class="nav-icon">
                        <i class="bi bi-person-circle"></i>
                    </span>

                    <span class="nav-text">
                        Profile
                    </span>

                </a>

            </nav>


            <!-- Sidebar Bottom -->

            <div class="sidebar-bottom">

                <!-- Mini information card -->

                <div class="sidebar-tip">

                    <div class="tip-icon">
                        <i class="bi bi-lightbulb"></i>
                    </div>

                    <div>

                        <strong>
                            Smart Finance
                        </strong>

                        <small>
                            Stay on top of your money.
                        </small>

                    </div>

                </div>


                <!-- Logout -->

                <form asp-area="Identity" asp-page="/Account/Logout" method="post">

                    <button type="submit" class="sidebar-link sidebar-logout">

                        <span class="nav-icon">
                            <i class="bi bi-box-arrow-right"></i>
                        </span>

                        <span class="nav-text">
                            Logout
                        </span>

                    </button>

                </form>

            </div>

        </aside>


        <!-- ================= MAIN WRAPPER ================= -->

        <div class="main-wrapper">


            <!-- ================= TOP HEADER ================= -->

            <header class="top-header">

                <div class="header-left">

                    <!-- Mobile menu -->

                    <button type="button" class="btn sidebar-toggle d-lg-none" id="sidebarToggle">

                        <i class="bi bi-list"></i>

                    </button>


                    <div>

                        <div class="page-title">
                            @ViewData["Title"]
                        </div>

                        <div class="page-subtitle">
                            Manage your finances with confidence
                        </div>

                    </div>

                </div>


                <!-- User -->

                <div class="user-section">

                    @{
                        var currentUser =
                            await UserManager.GetUserAsync(User);
                    }


                    <a asp-controller="Profile" asp-action="Index" class="user-info">


                        <div class="user-avatar">

                            @if (!string.IsNullOrEmpty(currentUser?.ProfileImage))
                            {
                                <img src="~/images/profiles/@currentUser.ProfileImage" alt="Profile" class="user-profile-image" />
                            }
                            else
                            {
                                <i class="bi bi-person-fill"></i>
                            }

                        </div>


                        <div class="user-details d-none d-sm-flex">

                            <span class="user-name">

                                @(currentUser?.FullName ?? "User")

                            </span>

                            <small>

                                @(currentUser?.Email ?? "")

                            </small>

                        </div>


                        <i class="bi bi-chevron-down user-arrow d-none d-sm-block"></i>

                    </a>

                </div>

            </header>


            <!-- ================= PAGE CONTENT ================= -->

            <main class="main-content">


                <!-- Success Message -->

                @if (TempData["SuccessMessage"] != null)
                {

                    <div class="alert fin-alert fin-alert-success
                        alert-dismissible fade show" role="alert">

                        <div class="alert-icon">

                            <i class="bi bi-check-lg"></i>

                        </div>

                        <div class="alert-content">

                            <strong>
                                Success
                            </strong>

                            <span>
                                @TempData["SuccessMessage"]
                            </span>

                        </div>

                        <button type="button" class="btn-close" data-bs-dismiss="alert">
                        </button>

                    </div>

                }


                <!-- Error Message -->

                @if (TempData["ErrorMessage"] != null)
                {

                    <div class="alert fin-alert fin-alert-danger
                        alert-dismissible fade show" role="alert">

                        <div class="alert-icon">

                            <i class="bi bi-exclamation-lg"></i>

                        </div>

                        <div class="alert-content">

                            <strong>
                                Error
                            </strong>

                            <span>
                                @TempData["ErrorMessage"]
                            </span>

                        </div>

                        <button type="button" class="btn-close" data-bs-dismiss="alert">
                        </button>

                    </div>

                }


                @RenderBody()

            </main>

        </div>

    </div>


    <!-- ================= MOBILE OVERLAY ================= -->

    <div id="sidebarOverlay" class="sidebar-overlay">
    </div>


    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


    <!-- Application JS -->

    <script src="~/js/site.js" asp-append-version="true">
    </script>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>