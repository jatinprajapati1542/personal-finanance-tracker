@using Microsoft.AspNetCore.Identity
@using personal_finance_Tracker.Models
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Expense & Income Tracker
    </title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Application CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <div class="app-wrapper">

        <!-- Sidebar -->

        <aside id="sidebar" class="sidebar">

            <div class="sidebar-header">

                <a asp-controller="Dashboard" asp-action="Index" class="sidebar-brand">

                    <i class="bi bi-wallet2"></i>

                    <span>
                        Expense Tracker
                    </span>

                </a>

            </div>


            <!-- Navigation -->

            <nav class="sidebar-nav">

                <a asp-controller="Dashboard" asp-action="Index" class="sidebar-link">

                    <i class="bi bi-grid-1x2-fill"></i>

                    <span>Dashboard</span>

                </a>


                <a asp-controller="Income" asp-action="Index" class="sidebar-link">

                    <i class="bi bi-cash-stack"></i>

                    <span>Income</span>

                </a>


                <a asp-controller="Expense" asp-action="Index" class="sidebar-link">

                    <i class="bi bi-wallet"></i>

                    <span>Expenses</span>

                </a>


                <a asp-controller="Transaction" asp-action="Index" class="sidebar-link">

                    <i class="bi bi-receipt me-2"></i>

                    Transactions

                </a>


                <div class="sidebar-divider"></div>


                <a asp-controller="Profile" asp-action="Index" class="sidebar-link">

                    <i class="bi bi-person-circle"></i>

                    <span>Profile</span>

                </a>

            </nav>


            <!-- Logout -->

            <div class="sidebar-footer">

                <form asp-area="Identity" asp-page="/Account/Logout" method="post">

                    <button type="submit" class="sidebar-link sidebar-logout">

                        <i class="bi bi-box-arrow-right"></i>

                        <span>Logout</span>

                    </button>

                </form>

            </div>

        </aside>


        <!-- Main Area -->

        <div class="main-wrapper">

            <!-- Top Header -->

            <header class="top-header">

                <div class="d-flex align-items-center">

                    <!-- Mobile sidebar button -->

                    <button type="button" class="btn sidebar-toggle d-lg-none" id="sidebarToggle">

                        <i class="bi bi-list"></i>

                    </button>

                    <h5 class="mb-0">
                        @ViewData["Title"]
                    </h5>

                </div>


                <!-- User -->

                <div class="user-section">

                    @{
                        var currentUser =
                            await UserManager.GetUserAsync(User);
                    }

                    <a asp-controller="Profile" asp-action="Index" class="user-info">

                        <div class="user-avatar">

                            <i class="bi bi-person"></i>

                        </div>

                        <div class="user-details d-none d-sm-block">

                            <span class="user-name">
                                @(currentUser?.FullName ?? "User")
                            </span>

                            <small>
                                @(currentUser?.Email ?? "")
                            </small>

                        </div>

                    </a>

                </div>

            </header>


            <!-- Page Content -->

            <main class="main-content">

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">

                        <i class="bi bi-check-circle me-2"></i>

                        @TempData["SuccessMessage"]

                        <button type="button" class="btn-close" data-bs-dismiss="alert">
                        </button>

                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">

                        <i class="bi bi-exclamation-circle me-2"></i>

                        @TempData["ErrorMessage"]

                        <button type="button" class="btn-close" data-bs-dismiss="alert">
                        </button>

                    </div>
                }

                @RenderBody()

            </main>

        </div>

    </div>


    <!-- Mobile sidebar overlay -->

    <div id="sidebarOverlay" class="sidebar-overlay">
    </div>


    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <!-- Application JS -->

    <script src="~/js/site.js" asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>