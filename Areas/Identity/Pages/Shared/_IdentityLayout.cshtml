@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Expense & Income Tracker</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        body {
            min-height: 100vh;
            margin: 0;
            background: #f5f7fb;
        }

        .identity-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 15px;
        }

        .identity-card {
            width: 100%;
            max-width: 430px;
            background: #ffffff;
            border: 0;
            border-radius: 18px;
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
            overflow: hidden;
        }

        .identity-content {
            padding: 35px;
        }

        .brand-icon {
            width: 65px;
            height: 65px;
            margin: 0 auto 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 16px;
            background: #0d6efd;
            color: white;
            font-size: 30px;
        }

        .brand-title {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .brand-subtitle {
            color: #6c757d;
            font-size: 14px;
        }

        .form-control {
            border-radius: 10px;
        }

        .form-control:focus {
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.12);
        }

        .btn-primary {
            border-radius: 10px;
            font-weight: 600;
        }

        .identity-footer {
            text-align: center;
            padding: 15px 30px 25px;
            color: #6c757d;
            font-size: 13px;
        }

        @@media (max-width: 576px) {
            .identity-content {
                padding: 28px 22px;
            }
        }
    </style>
</head>

<body>

    <div class="identity-wrapper">

        <div class="identity-card">

            <div class="identity-content">
                @RenderBody()
            </div>

            <div class="identity-footer">
                © @DateTime.Now.Year Expense & Income Tracker
            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>